CI_ENVIRONMENT=development

# Application
app.baseURL='http://localhost:8080/'

# Database (fill real values in your local .env, do NOT commit secrets)
database.default.hostname=localhost
database.default.database=ci4_gatorade
database.default.username=root
database.default.password=
database.default.DBDriver=MySQLi

# Admin bootstrap (change after first login locally)
DEFAULT_ADMIN_PASSWORD=CHANGE_ME

# Uncomment and adjust only if you need overrides
# security.csrfProtection='cookie'
# logger.threshold=4

# Notes:
# 1) Copy this file to .env after cloning:  copy .env.example .env (Windows) or cp .env.example .env (Linux/Mac)
# 2) Never push your real .env. .gitignore already blocks it.
# 3) Rotate DEFAULT_ADMIN_PASSWORD once an admin user is created.
# 4) Add any new keys here as placeholders so the team knows what to configure.